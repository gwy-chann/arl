# Supabase Project Configuration
# Found at: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Gemini API Key (In-App AI Store Assistant)
# Obtain a free-tier key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Optional: Set to 'true' to enable local/offline deterministic mode without a Gemini key
# ASSISTANT_OFFLINE_MODE=true

# TextBee Android SMS Gateway Configuration (Server-Only Secrets)
# Documentation: https://textbee.dev
SMS_GATEWAY_PROVIDER="textbee"
TEXTBEE_API_KEY="your_textbee_api_key_here"
TEXTBEE_DEVICE_ID="your_paired_android_device_id_here"
TEXTBEE_BASE_URL="https://api.textbee.dev/api/v1"
TEXTBEE_MOCK_DISPATCH="false" # Set to "true" in CI/development to prevent actual SIM SMS dispatches

# Scheduled Cron Security Secret
# Used to authenticate Vercel Cron or background worker sweep triggers
CRON_SECRET="your_cron_secret_token_here"
