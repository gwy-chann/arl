# Supabase Project Configuration
# Found at: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Gemini API Key (In-App AI Store Assistant)
# Obtain a free-tier key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Optional: Set to 'true' to enable local/offline deterministic mode without a Gemini key
# ASSISTANT_OFFLINE_MODE=true

# PhilSMS Gateway Configuration (Server-Only Secrets)
# API Documentation: https://app.philsms.com/api/v3
PHILSMS_API_BASE_URL="https://app.philsms.com/api/v3"
PHILSMS_API_TOKEN="your_philsms_bearer_token_here"
PHILSMS_SENDER_ID="PhilSMS" # Approved Alphanumeric Sender ID (e.g., PhilSMS or ARLQ)
PHILSMS_MOCK_DISPATCH="false" # Set to "true" in CI/development to prevent actual carrier billing

# Scheduled Cron Security Secret
# Used to authenticate Vercel Cron or background worker sweep triggers
CRON_SECRET="your_cron_secret_token_here"
